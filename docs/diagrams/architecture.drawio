        </mxCell>
        <mxCell id="en_note" value="297 testthat assertions: golden values, invariants (effort = team × schedule), continuity at the cap, wage linearity, drift between R/ and modules/." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#0A3542;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="490" y="470" width="360" height="60" as="geometry"/>
        </mxCell>

